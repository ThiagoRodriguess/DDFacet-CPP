# Mantém LF em tudo que é texto: o projeto é compilado e executado no Linux
# (WSL / cluster). Scripts .sh com CRLF falham com erros do tipo "\r: command
# not found", e o Git converteria para CRLF por padrão no Windows.
* text=auto eol=lf

*.sh   text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Binários: nunca converter
*.pdf  binary
*.fits binary
*.png  binary
*.vis  binary
